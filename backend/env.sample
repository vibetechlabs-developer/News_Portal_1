# --- Email (contact form + password reset + career acceptance) ---
# Without SMTP: Django defaults to console backend — emails are ONLY printed in the server
# terminal; nothing is delivered. Switch to SMTP for real sending (Gmail example below).
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=kanamexpress@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# Use Gmail "App passwords" (Google Account → Security → 2-Step Verification → App passwords).
# The normal Gmail login password will NOT work for SMTP.
#
# DEFAULT_FROM_EMAIL=Kanam Express <kanamexpress@gmail.com>
# CONTACT_ADMIN_EMAIL=kanamexpress@gmail.com
#
# Local/dev — keep backend console-only:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Optional: logging level (INFO, DEBUG, WARNING)
# DJANGO_LOG_LEVEL=INFO

# Optional: external Cricket API (RapidAPI or similar)
# Enable/disable the cricket proxy endpoint
# CRICKET_API_ENABLED=True
# Full base URL for the upstream API (e.g. https://cricbuzz-cricket.p.rapidapi.com/news/v1/index)
# CRICKET_API_BASE_URL=https://example-cricket-api.p.rapidapi.com/news
# RapidAPI host header value (e.g. cricbuzz-cricket.p.rapidapi.com)
# CRICKET_API_HOST=your-rapidapi-host
# RapidAPI key
# CRICKET_API_KEY=your-rapidapi-key

# Optional: separate live matches endpoint (e.g. Cricbuzz matches/v1/live)
# If set, backend will expose it under /api/v1/news/cricket-live-matches/
# CRICKET_MATCHES_API_URL=https://cricbuzz-cricket.p.rapidapi.com/matches/v1/live

# Optional: Web Push (Chrome/Edge browser notifications)
# Generate VAPID keys and set these in production.
# WEB_PUSH_PUBLIC_KEY=...
# WEB_PUSH_PRIVATE_KEY=...
# WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# Optional: Firebase Cloud Messaging (Android / iOS native apps)
# Install dependency: firebase-admin (see requirements.txt)
# Use EITHER a file path OR raw JSON (JSON is convenient for some hosts / secret managers).
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccount.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# Public URL prefix embedded in notification data (open in WebView / external browser).
# FCM_DEEPLINK_BASE_URL=https://www.kanamexpress.com